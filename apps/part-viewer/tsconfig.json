{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@toolpath/viewer": ["../../packages/viewer/src/index.ts"],
      "@toolpath/viewer/engine": ["../../packages/viewer/src/engine/index.ts"]
    }
  },
  "include": ["app", "server", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
