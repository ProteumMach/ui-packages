{
  "name": "@toolpath/api",
  "version": "0.2.2",
  "description": "TypeScript bindings and upload helper for the Toolpath Engine API",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toolpath/toolpath.git",
    "directory": "packages/sdk-typescript"
  },
  "homepage": "https://developers.toolpath.com",
  "bugs": {
    "url": "https://github.com/toolpath/toolpath/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/index.js",
